@using Orbit.Application.Authorization
@using Orbit.Application.Authorization.Models
@using Orbit.Web.Components.Controls
@using static Orbit.Web.Components.Controls.MessageDialog

<div class="space-y-6">
    @if (selectedRole == null)
    {
        <!-- Role Selection State -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="px-8 py-6 border-b border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-gray-50/50 dark:bg-gray-800/50">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 tracking-tight">Roller</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Sistemdeki rolleri ve yetkilerini yönetin</p>
                </div>
                <!-- View Toggle Buttons -->
                <div class="flex items-center bg-gray-200 dark:bg-gray-700 rounded-lg p-1">
                    <button class="p-2 rounded-md transition-all @GetViewButtonClass("list")" @onclick='() => SetViewMode("list")' title="Liste Görünümü">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </button>
                    <button class="p-2 rounded-md transition-all @GetViewButtonClass("grid")" @onclick='() => SetViewMode("grid")' title="Kutu Görünümü">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    </button>
                </div>
            </div>

            <div class="p-6">
                @if (loadingRoles)
                {
                    <div class="flex justify-center items-center py-20">
                        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-primary"></div>
                    </div>
                }
                else
                {
                    @if (roleViewMode == "list")
                    {
                        <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
                            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                                <thead class="bg-gray-50 dark:bg-gray-900/50">
                                    <tr>
                                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Rol Adı</th>
                                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Açıklama</th>
                                        <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                                    @foreach (var role in paginatedRoles)
                                    {
                                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors cursor-pointer group" @onclick="() => SelectRoleAsync(role.Id)">
                                            <td class="px-6 py-4 whitespace-nowrap">
                                                <div class="text-sm font-bold text-gray-900 dark:text-gray-100 group-hover:text-primary transition-colors">@role.Name</div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <div class="text-sm text-gray-500 dark:text-gray-400 line-clamp-1">@role.Description</div>
                                            </td>
                                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                                <span class="text-primary hover:text-primary/80 font-semibold flex items-center justify-end gap-1 ml-auto opacity-0 group-hover:opacity-100 transition-opacity">
                                                    Düzenle
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                                    </svg>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                            @foreach (var role in paginatedRoles)
                            {
                                <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:border-primary/50 hover:shadow-lg hover:-translate-y-1 transition-all cursor-pointer group" @onclick="() => SelectRoleAsync(role.Id)">
                                    <div class="flex justify-between items-start mb-4">
                                        <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                            </svg>
                                        </div>
                                        <span class="text-xs font-semibold bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 px-2.5 py-1 rounded-full">
                                           Aktif
                                        </span>
                                    </div>
                                    <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-primary transition-colors">@role.Name</h3>
                                    <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2 min-h-[2.5rem] leading-relaxed">
                                        @(string.IsNullOrEmpty(role.Description) ? "Bu rol için açıklama bulunmuyor." : role.Description)
                                    </p>
                                </div>
                            }
                        </div>
                    }

                    <!-- Pagination -->
                    @if (totalPages > 1)
                    {
                        <div class="flex items-center justify-between border-t border-gray-200 dark:border-gray-700 pt-6 mt-6">
                            <div class="flex flex-1 justify-between sm:hidden">
                                <button @onclick="PreviousPage" disabled="@(currentPage == 1)" class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50">Önceki</button>
                                <button @onclick="NextPage" disabled="@(currentPage == totalPages)" class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50">Sonraki</button>
                            </div>
                            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                                <div>
                                    <p class="text-sm text-gray-700 dark:text-gray-300">
                                        Toplam <span class="font-medium text-gray-900 dark:text-white">@roles.Count</span> kayıttan <span class="font-medium text-gray-900 dark:text-white">@((currentPage - 1) * itemsPerPage + 1)</span> - <span class="font-medium text-gray-900 dark:text-white">@Math.Min(currentPage * itemsPerPage, roles.Count)</span> arası
                                    </p>
                                </div>
                                <div>
                                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                                        <button @onclick="PreviousPage" disabled="@(currentPage == 1)" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 disabled:opacity-50 transition-colors">
                                            <span class="sr-only">Önceki</span>
                                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                                        </button>
                                        @for (int i = 1; i <= totalPages; i++)
                                        {
                                            var pageIndex = i;
                                            <button @onclick="() => { currentPage = pageIndex; ApplyPagination(); }" class="relative z-10 inline-flex items-center @(currentPage == i ? "bg-primary text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" : "text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:outline-offset-0") px-4 py-2 text-sm font-semibold transition-colors">
                                                @i
                                            </button>
                                        }
                                        <button @onclick="NextPage" disabled="@(currentPage == totalPages)" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 disabled:opacity-50 transition-colors">
                                            <span class="sr-only">Sonraki</span>
                                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                                        </button>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
    else
    {
        <!-- Permission Management State -->
        <div class="max-w-5xl mx-auto space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
            <!-- Header -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex items-center gap-3">
                    <button @onclick="BackToRoleSelection" class="group p-2 -ml-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500 dark:text-gray-400 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                    </button>
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
                            <span class="text-gray-400 dark:text-gray-500 font-normal">Rol:</span> @selectedRole.Name
                        </h1>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">@selectedRole.Description</p>
                    </div>
                </div>
                
                <div class="flex items-center gap-3">
                    <button @onclick="BackToRoleSelection" class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                        Vazgeç
                    </button>
                    <button @onclick="BackToRoleSelection" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary/90 shadow-sm transition-colors">
                        Kaydet ve Çık
                    </button>
                </div>
            </div>

            <!-- Search and Filter Bar -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
                <div class="flex flex-col sm:flex-row gap-4 items-center">
                    <div class="relative flex-1 w-full">
                         <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                        <input type="text" 
                               @bind="searchTerm" 
                               @bind:event="oninput"
                               placeholder="İzinlerde ara..." 
                               class="block w-full rounded-lg border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-900/50 pl-10 pr-3 py-2.5 text-sm text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
                    </div>
                    
                    <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end border-t sm:border-t-0 border-gray-100 dark:border-gray-700 pt-4 sm:pt-0">
                         <div class="flex items-center gap-2 px-3 py-1 bg-blue-50 dark:bg-blue-900/20 rounded-md border border-blue-100 dark:border-blue-900/30">
                            <span class="font-bold text-blue-600 dark:text-blue-400">@filteredPermissions.Count(p => p.IsAssigned)</span>
                            <span class="text-xs text-blue-500 dark:text-blue-300">/ @filteredPermissions.Count izin atandı</span>
                         </div>
                    </div>
                </div>
                
                <!-- Quick Actions -->
                <div class="flex justify-end gap-6 mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
                     <button @onclick="AssignAllVisiblePermissionsAsync" 
                             disabled="@(!filteredPermissions.Any(p => !p.IsAssigned) || bulkOperationInProgress)"
                             class="text-sm font-semibold text-primary hover:text-primary/80 disabled:opacity-50 transition-colors">
                        Hepsini Ata
                    </button>
                    <button @onclick="RemoveAllVisiblePermissionsAsync"
                             disabled="@(!filteredPermissions.Any(p => p.IsAssigned) || bulkOperationInProgress)"
                             class="text-sm font-semibold text-gray-500 hover:text-red-600 disabled:opacity-50 transition-colors">
                        Hepsini Kaldır
                    </button>
                </div>
            </div>

            <!-- Content -->
             <div class="space-y-4">
                @if (loadingPermissions)
                {
                    <div class="flex justify-center items-center py-20 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
                        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-primary"></div>
                    </div>
                }
                else if (!filteredPermissions.Any())
                {
                    <div class="text-center py-20 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
                        <div class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-gray-100 dark:bg-gray-700 mb-4">
                             <svg class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100">Sonuç bulunamadı</h3>
                        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Arama kriterlerinize uygun izin bulunmamaktadır.</p>
                        <button @onclick='() => searchTerm = ""' class="mt-6 text-primary hover:text-primary/80 font-medium">Filtreyi Temizle</button>
                    </div>
                }
                else
                {
                    @foreach (var group in GroupedPermissions)
                    {
                        var isCollapsed = collapsedGroups.Contains(group.Key);
                        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                            <!-- Group Header -->
                            <div @onclick="() => ToggleGroup(group.Key)" 
                                 class="px-6 py-4 flex justify-between items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors select-none">
                                <div class="flex items-center gap-4">
                                    <div class="h-10 w-10 rounded-lg bg-gray-100 dark:bg-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400">
                                        @if(group.Key.ToLower() == "users") {
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                                        } else if (group.Key.ToLower() == "roles") {
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                                        } else if (group.Key.ToLower() == "permissions") {
                                             <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11.536 19.464a4.75 4.75 0 00-1.859 1.859m-1.92-1.92a4.75 4.75 0 011.859-1.859L17.5 13m-2.5-3a2 2 0 11-4 0 2 2 0 014 0zM5 7a2 2 0 012-2h3.293A24.71 24.71 0 007 9c0 1.133.081 2.253.233 3.35L4.743 14.849a6 6 0 01-2.903-4.143C1.657 9.948 1.5 8.99 1.5 8a6 6 0 016-6z" /></svg>
                                        } else {
                                             <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                                        }
                                        
                                    </div>
                                    <span class="text-lg font-bold text-gray-900 dark:text-gray-100 capitalize">@group.Key</span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
                                        @group.Value.Count
                                    </span>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 transition-transform duration-200 @(isCollapsed ? "" : "rotate-180")" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                            </div>
                            
                            <!-- Group Content -->
                            @if (!isCollapsed)
                            {
                                <div class="divide-y divide-gray-100 dark:divide-gray-700/50 border-t border-gray-100 dark:border-gray-700/50">
                                    @foreach (var perm in group.Value)
                                    {
                                        <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                            <div class="pr-8">
                                                <p class="text-sm font-bold text-gray-900 dark:text-gray-100">@perm.Permission.Code</p>
                                                <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">@perm.Permission.Description</p>
                                            </div>
                                            
                                            <button type="button" 
                                                    @onclick="() => TogglePermissionAsync(perm)"
                                                    disabled="@(processingPermissions.Contains(perm.Permission.Id) || bulkOperationInProgress)"
                                                    class="@(perm.IsAssigned ? "bg-primary" : "bg-gray-200 dark:bg-gray-600") relative inline-flex h-7 w-12 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50" 
                                                    role="switch" 
                                                    aria-checked="@perm.IsAssigned">
                                                <span class="sr-only">Toggle permission</span>
                                                <span aria-hidden="true" 
                                                      class="@(perm.IsAssigned ? "translate-x-5" : "translate-x-0") pointer-events-none inline-block h-6 w-6 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out">
                                                </span>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
             </div>
        </div>
    }
</div>

<MessageDialog Visible="@showMessageDialog"
               Type="@messageType"
               Title="@messageTitle"
               Message="@messageContent"
               OnOk="CloseMessageDialog" />

@code {
    [Inject] IRoleQueries RoleQueries { get; set; } = default!;
    [Inject] IPermissionQueries PermissionQueries { get; set; } = default!;
    [Inject] IRolePermissionCommands RolePermissionCommands { get; set; } = default!;

    // Models
    class PermissionUiModel
    {
        public PermissionDto Permission { get; set; } = default!;
        public bool IsAssigned { get; set; }
    }

    // State
    List<RoleDto> roles = new();
    List<RoleDto> paginatedRoles = new();
    RoleDto? selectedRole;
    List<PermissionUiModel> allPermissions = new();
    string searchTerm = "";
    string roleViewMode = "list";
    int currentPage = 1;
    readonly int itemsPerPage = 12;
    int totalPages => (int)Math.Ceiling((double)roles.Count / itemsPerPage);
    
    // UI State
    HashSet<string> collapsedGroups = new();

    // Derived State
    List<PermissionUiModel> filteredPermissions => allPermissions
        .Where(p => string.IsNullOrWhiteSpace(searchTerm) || 
                    p.Permission.Code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
                    (p.Permission.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    Dictionary<string, List<PermissionUiModel>> GroupedPermissions => filteredPermissions
        .GroupBy(p => p.Permission.Code.Contains('.') ? p.Permission.Code.Split('.')[0] : "Diğer")
        .OrderBy(g => g.Key)
        .ToDictionary(g => g.Key, g => g.ToList());

    // Loading State
    bool loadingRoles = true;
    bool loadingPermissions;
    bool bulkOperationInProgress;
    HashSet<Guid> processingPermissions = new();

    // Dialog State
    bool showMessageDialog;
    string? messageTitle;
    string? messageContent;
    MessageType messageType;

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    // Role Management Methods
    async Task LoadRolesAsync()
    {
        loadingRoles = true;
        try
        {
            roles = (await RoleQueries.GetAllAsync()).ToList();
            ApplyPagination();
        }
        finally
        {
            loadingRoles = false;
        }
        StateHasChanged();
    }

    void ApplyPagination()
    {
        if (currentPage > totalPages && totalPages > 0) currentPage = 1;
        var skip = (currentPage - 1) * itemsPerPage;
        paginatedRoles = roles.Skip(skip).Take(itemsPerPage).ToList();
    }

    void SetViewMode(string mode) => roleViewMode = mode;
    
    string GetViewButtonClass(string mode) => roleViewMode == mode 
        ? "bg-white dark:bg-gray-600 shadow text-gray-900 dark:text-gray-100" 
        : "text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200";

    void PreviousPage() { if (currentPage > 1) { currentPage--; ApplyPagination(); } }
    void NextPage() { if (currentPage < totalPages) { currentPage++; ApplyPagination(); } }

    async Task SelectRoleAsync(Guid roleId)
    {
        selectedRole = roles.FirstOrDefault(r => r.Id == roleId);
        if (selectedRole == null) return;
        
        // Reset state
        searchTerm = "";
        collapsedGroups.Clear();
        await LoadPermissionsAsync(roleId);
    }

    void BackToRoleSelection()
    {
        selectedRole = null;
        allPermissions.Clear();
    }
    
    void ToggleGroup(string groupName)
    {
        if (collapsedGroups.Contains(groupName))
            collapsedGroups.Remove(groupName);
        else
            collapsedGroups.Add(groupName);
    }

    // Permission Logic
    async Task LoadPermissionsAsync(Guid roleId)
    {
        loadingPermissions = true;
        try
        {
            var roleWithIds = await PermissionQueries.GetRoleWithPermissionsAsync(roleId);
            var assigned = roleWithIds?.AssignedPermissions ?? new List<PermissionDto>();
            var available = roleWithIds?.AvailablePermissions ?? new List<PermissionDto>();

            allPermissions = assigned.Select(p => new PermissionUiModel { Permission = p, IsAssigned = true })
                .Concat(available.Select(p => new PermissionUiModel { Permission = p, IsAssigned = false }))
                .OrderBy(p => p.Permission.Code)
                .ToList();
        }
        catch (Exception ex)
        {
            ShowMessage("Hata", $"İzinler yüklenirken hata oluştu: {ex.Message}", MessageType.Error);
        }
        finally
        {
            loadingPermissions = false;
        }
    }

    async Task TogglePermissionAsync(PermissionUiModel model)
    {
        if (selectedRole == null || processingPermissions.Contains(model.Permission.Id)) return;

        processingPermissions.Add(model.Permission.Id);
        model.IsAssigned = !model.IsAssigned;
        StateHasChanged();

        try
        {
            if (model.IsAssigned)
                await RolePermissionCommands.AssignPermissionToRoleAsync(selectedRole.Id, model.Permission.Id);
            else
                await RolePermissionCommands.RemovePermissionFromRoleAsync(selectedRole.Id, model.Permission.Id);
        }
        catch (Exception ex)
        {
            model.IsAssigned = !model.IsAssigned;
            ShowMessage("Hata", $"İşlem başarısız: {ex.Message}", MessageType.Error);
        }
        finally
        {
            processingPermissions.Remove(model.Permission.Id);
            StateHasChanged();
        }
    }

    async Task AssignAllVisiblePermissionsAsync()
    {
        if (selectedRole == null) return;
        
        var toAssign = filteredPermissions.Where(p => !p.IsAssigned).ToList();
        if (!toAssign.Any()) return;

        bulkOperationInProgress = true;
        StateHasChanged();

        try
        {
            var ids = toAssign.Select(p => p.Permission.Id);
            await RolePermissionCommands.AssignMultiplePermissionsToRoleAsync(selectedRole.Id, ids);
            foreach (var item in toAssign) item.IsAssigned = true;
            ShowMessage("Başarılı", $"{toAssign.Count} izin başarıyla atandı.", MessageType.Success);
        }
        catch (Exception ex)
        {
            ShowMessage("Hata", $"Toplu atama sırasında hata: {ex.Message}", MessageType.Error);
        }
        finally
        {
            bulkOperationInProgress = false;
            StateHasChanged();
        }
    }

    async Task RemoveAllVisiblePermissionsAsync()
    {
        if (selectedRole == null) return;

        var toRemove = filteredPermissions.Where(p => p.IsAssigned).ToList();
        if (!toRemove.Any()) return;

        bulkOperationInProgress = true;
        StateHasChanged();

        try
        {
            var ids = toRemove.Select(p => p.Permission.Id);
            await RolePermissionCommands.RemoveMultiplePermissionsFromRoleAsync(selectedRole.Id, ids);
            foreach (var item in toRemove) item.IsAssigned = false;
            ShowMessage("Başarılı", $"{toRemove.Count} izin başarıyla kaldırıldı.", MessageType.Success);
        }
        catch (Exception ex)
        {
            ShowMessage("Hata", $"Toplu kaldırma sırasında hata: {ex.Message}", MessageType.Error);
        }
        finally
        {
            bulkOperationInProgress = false;
            StateHasChanged();
        }
    }

    void ShowMessage(string title, string message, MessageType type)
    {
        messageTitle = title;
        messageContent = message;
        messageType = type;
        showMessageDialog = true;
        StateHasChanged();
    }

    void CloseMessageDialog()
    {
        showMessageDialog = false;
    }
}
